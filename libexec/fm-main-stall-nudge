#!/usr/bin/env bash
set -u
: "${FM_HOME:?FM_HOME is not set}"
FM_HOME=${FM_HOME%/}
NOTE_MAX=${NOTE_MAX:-45}
WAKE_MAX=${WAKE_MAX:-600}
BOARD_MAX=${BOARD_MAX:-300}
GAP=${GAP:-120}
LAVISH_STATE=${LAVISH_STATE:-$HOME/.lavish-axi/state.json}
SESSION=${HERDR_SESSION:-default}
HERDR=${HERDR_BIN_PATH:-herdr}
MAIN_PANE=${MAIN_PANE:-}
STATE=$FM_HOME/state
STAMP=$STATE/.stall-nudge-last
LATCH=$STATE/.stall-nudge-boards
now=$(date +%s)
nudge_log() { echo "$(date -u +%FT%TZ) $*"; }

last=$(cat "$STAMP" 2>/dev/null || echo 0)
[ $((now - last)) -lt "$GAP" ] && exit 0

oldest_note=$(stat -f %m "$STATE"/inbox/*.note 2>/dev/null | sort -n | head -1)
oldest_wake=$(cut -f1 "$STATE/.wake-queue" 2>/dev/null | sort -n | head -1)
reason=
board_key=
[ -n "$oldest_note" ] && [ $((now - oldest_note)) -gt "$NOTE_MAX" ] && reason="an operator note waits $((now - oldest_note))s"
[ -z "$reason" ] && [ -n "$oldest_wake" ] && [ $((now - oldest_wake)) -gt "$WAKE_MAX" ] && reason="a wake waits $((now - oldest_wake))s"
if [ -z "$reason" ]; then
  read -r board board_key < <(BOARD_MAX=$BOARD_MAX LATCH=$LATCH LAVISH_STATE=$LAVISH_STATE python3 - <<'PY'
import json, os, time
from datetime import datetime
latch = os.environ["LATCH"]
seen = set(open(latch).read().split()) if os.path.exists(latch) else set()
try:
    sessions = json.load(open(os.environ["LAVISH_STATE"]))["sessions"]
except (OSError, ValueError, KeyError):
    raise SystemExit
for sid, s in sessions.items():
    chat = s.get("chat") or []
    if not chat or chat[-1].get("role") != "user":
        continue
    at = chat[-1].get("at", "")
    try:
        age = time.time() - datetime.fromisoformat(at.replace("Z", "+00:00")).timestamp()
    except ValueError:
        continue
    if f"{sid}@{at}" not in seen and int(os.environ["BOARD_MAX"]) < age < 86400:
        print(sid, f"{sid}@{at}")
        break
PY
)
  [ -n "$board_key" ] && reason="an answer on Lavish board $board has no reply"
fi
[ -z "$reason" ] && exit 0
echo "$now" > "$STAMP"

if [ -z "$MAIN_PANE" ]; then
  MAIN_PANE=$(HERDR_SESSION=$SESSION "$HERDR" pane list --session "$SESSION" 2>/dev/null \
    | jq -r --arg home "$FM_HOME" '[.result.panes[] | select(.agent and .foreground_cwd == $home) | .pane_id][0] // empty' 2>/dev/null)
fi
if [ -z "$MAIN_PANE" ]; then
  nudge_log "no main pane: no herdr pane in session $SESSION runs an agent in $FM_HOME; $reason" >&2
  exit 1
fi
target=$SESSION:$MAIN_PANE

cd "$FM_HOME" || exit 1
. bin/fm-backend.sh
msg="stall watchdog: $reason. Run bin/fm-wake-drain.sh, answer every operator note and reply to any answered Lavish board now."
out=$(fm_backend_send_text_submit herdr "$target" "$msg" 2 0.4 0.3)
rc=$?
verdict=${out##*$'\n'}
if [ "$rc" -ne 0 ] || [ -z "$verdict" ] || [ "$verdict" = send-failed ]; then
  nudge_log "nudge FAILED for $target: $reason: rc=$rc verdict=${verdict:-none}" >&2
  exit 1
fi
[ -n "$board_key" ] && echo "$board_key" >> "$LATCH"
case $verdict in
  empty) nudge_log "nudged $target: $reason" ;;
  *) nudge_log "nudge uncertain for $target: $reason: verdict=$verdict, text may be typed" ;;
esac
