+def gh_aliases():
+    base = os.environ.get("GH_CONFIG_DIR") or os.path.join(
+        os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config"), "gh")
+    try:
+        lines = open(os.path.join(base, "config.yml")).read().splitlines()
+    except OSError:
+        return {}
+    aliases, inside = {}, False
+    for line in lines:
+        if not line.strip() or line.lstrip().startswith("#"):
+            continue
+        if not line[0].isspace():
+            inside = line.rstrip() == "aliases:"
+            continue
+        name, sep, value = line.strip().partition(":")
+        if inside and sep:
+            value = value.strip()
+            if len(value) > 1 and value[0] == value[-1] == "'":
+                value = value[1:-1].replace("''", "'")
+            elif len(value) > 1 and value[0] == value[-1] == '"':
+                value = json.loads(value)
+            aliases[name.strip().strip("'\"")] = value
+    return aliases
+
+
+def expand_alias(argv):
+    expansion = gh_aliases().get(argv[0]) if argv else None
+    if expansion is None or expansion.startswith("!"):
+        return argv
+    words, rest = shlex.split(expansion), list(argv[1:])
+    used = set()
+    for n, value in enumerate(rest, 1):
+        if any(f"${n}" in word for word in words):
+            words = [word.replace(f"${n}", value) for word in words]
+            used.add(n)
+    return words + [value for n, value in enumerate(rest, 1) if n not in used]
+
+
